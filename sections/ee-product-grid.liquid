{{ 'ee-product-grid.css' | asset_url | stylesheet_tag }}
<script src="{{ 'ee-product-grid.js' | asset_url }}" defer="defer"></script>

<ee-test-product-grid
  id="ee-test-product-grid-{{ section.id }}"
  class="ee-test-product-grid"
  data-section-id="{{ section.id }}"
>
  <div class="ee-test-product-grid__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="ee-test-product-grid__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {%- endif -%}

    <div class="ee-test-product-grid__grid">
      {%- for block in section.blocks -%}
        {%- assign product = block.settings.product -%}

        {%- if product != blank -%}
          <article
            class="ee-test-product-grid__item"
            {{ block.shopify_attributes }}
          >
            <div class="ee-test-product-grid__image-wrapper">
              {%- if product.featured_image != blank -%}
                {{
                  product.featured_image
                  | image_url: width: 1000
                  | image_tag:
                    widths: '320, 480, 640, 800, 1000',
                    sizes: '(max-width: 749px) 50vw, 33vw',
                    loading: 'lazy',
                    class: 'ee-test-product-grid__image',
                    alt: product.featured_image.alt | default: product.title
                }}
              {%- else -%}
                <div class="ee-test-product-grid__image-placeholder">
                  {{ product.title | escape }}
                </div>
              {%- endif -%}

              <button
                type="button"
                class="ee-test-product-grid__hotspot"
                data-ee-test-hotspot
                data-block-id="{{ block.id }}"
                aria-label="
                  {%- if block.settings.hotspot_label != blank -%}
                    {{ block.settings.hotspot_label | escape }}
                  {%- else -%}
                    View {{ product.title | escape }}
                  {%- endif -%}
                "
                style="
                  --ee-test-hotspot-desktop-x: {{ block.settings.desktop_x }}%;
                  --ee-test-hotspot-desktop-y: {{ block.settings.desktop_y }}%;
                  --ee-test-hotspot-mobile-x: {{ block.settings.mobile_x }}%;
                  --ee-test-hotspot-mobile-y: {{ block.settings.mobile_y }}%;
                "
              >
                <span
                  class="ee-test-product-grid__hotspot-icon"
                  aria-hidden="true"
                ></span>
              </button>
            </div>
          </article>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div
    class="ee-test-product-grid__modal"
    data-ee-test-modal
    hidden
  >
    <div
      class="ee-test-product-grid__backdrop"
      data-ee-test-modal-backdrop
      aria-hidden="true"
    ></div>

    <div
      class="ee-test-product-grid__dialog"
      data-ee-test-dialog
      role="dialog"
      aria-modal="true"
      aria-labelledby="ee-test-product-dialog-title-{{ section.id }}"
    >
      <button
        type="button"
        class="ee-test-product-grid__close"
        data-ee-test-modal-close
        aria-label="Close product details"
      >
        <span aria-hidden="true"></span>
      </button>

      <div class="ee-test-product-grid__dialog-content">
        <div class="ee-test-product-grid__popup-media">
          <img
            class="ee-test-product-grid__popup-image"
            data-ee-test-popup-image
            src=""
            alt=""
            width="600"
            height="600"
          >
        </div>

        <div class="ee-test-product-grid__popup-details">
          <h3
            id="ee-test-product-dialog-title-{{ section.id }}"
            class="ee-test-product-grid__popup-title"
            data-ee-test-popup-title
          ></h3>

          <div class="ee-test-product-grid__price-row">
            <span
              class="ee-test-product-grid__price"
              data-ee-test-popup-price
            ></span>

            <s
              class="ee-test-product-grid__compare-price"
              data-ee-test-popup-compare-price
              hidden
            ></s>
          </div>

          <p
            class="ee-test-product-grid__description"
            data-ee-test-popup-description
          ></p>

          <div
            class="ee-test-product-grid__options"
            data-ee-test-options
          ></div>

          <p
            class="ee-test-product-grid__availability"
            data-ee-test-availability
          ></p>

          <button
            type="button"
            class="ee-test-product-grid__add-button"
            data-ee-test-add-button
            disabled
          >
            Add to cart
          </button>

          <div
            class="ee-test-product-grid__status"
            data-ee-test-status
            aria-live="polite"
            aria-atomic="true"
          ></div>
        </div>
      </div>
    </div>
  </div>

  <script
    type="application/json"
    data-ee-test-products
  >
    {
      "products": [
        {%- assign rendered_products = 0 -%}

        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}

          {%- if product != blank -%}
            {%- if rendered_products > 0 -%},{%- endif -%}

            {
              "blockId": {{ block.id | json }},
              "id": {{ product.id | json }},
              "title": {{ product.title | json }},
              "url": {{ product.url | json }},
              "description": {{ product.description | strip_html | strip | json }},

              "featuredImage":
                {%- if product.featured_image != blank -%}
                  {
                    "src": {{ product.featured_image | image_url: width: 1200 | json }},
                    "alt": {{ product.featured_image.alt | default: product.title | json }},
                    "width": {{ product.featured_image.width | json }},
                    "height": {{ product.featured_image.height | json }}
                  }
                {%- else -%}
                  null
                {%- endif -%},

              "defaultVariantId":
                {%- if product.selected_or_first_available_variant != blank -%}
                  {{ product.selected_or_first_available_variant.id | json }}
                {%- else -%}
                  null
                {%- endif -%},

              "options": [
                {%- for option in product.options_with_values -%}
                  {
                    "name": {{ option.name | json }},
                    "position": {{ option.position | json }},
                    "values": [
                      {%- for value in option.values -%}
                        {{ value | json }}{% unless forloop.last %},{% endunless %}
                      {%- endfor -%}
                    ]
                  }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              ],

              "variants": [
                {%- for variant in product.variants -%}
                  {
                    "id": {{ variant.id | json }},
                    "available": {{ variant.available | json }},
                    "options": {{ variant.options | json }},
                    "price": {{ variant.price | json }},
                    "priceFormatted": {{ variant.price | money | json }},

                    "compareAtPrice":
                      {%- if variant.compare_at_price != blank -%}
                        {{ variant.compare_at_price | json }}
                      {%- else -%}
                        null
                      {%- endif -%},

                    "compareAtPriceFormatted":
                      {%- if variant.compare_at_price != blank -%}
                        {{ variant.compare_at_price | money | json }}
                      {%- else -%}
                        null
                      {%- endif -%},

                    "image":
                      {%- if variant.featured_image != blank -%}
                        {
                          "src": {{ variant.featured_image | image_url: width: 1200 | json }},
                          "alt": {{ variant.featured_image.alt | default: product.title | json }},
                          "width": {{ variant.featured_image.width | json }},
                          "height": {{ variant.featured_image.height | json }}
                        }
                      {%- else -%}
                        null
                      {%- endif -%}
                  }{% unless forloop.last %},{% endunless %}
                {%- endfor -%}
              ]
            }

            {%- assign rendered_products = rendered_products | plus: 1 -%}
          {%- endif -%}
        {%- endfor -%}
      ]
    }
  </script>
</ee-test-product-grid>

{% schema %}
{
  "name": "EE product grid",
  "tag": "section",
  "class": "ee-test-product-grid-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "header",
          "content": "Desktop hotspot"
        },
        {
          "type": "range",
          "id": "desktop_x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Horizontal position",
          "default": 50
        },
        {
          "type": "range",
          "id": "desktop_y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Vertical position",
          "default": 50
        },
        {
          "type": "header",
          "content": "Mobile hotspot"
        },
        {
          "type": "range",
          "id": "mobile_x",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Horizontal position",
          "default": 50
        },
        {
          "type": "range",
          "id": "mobile_y",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Vertical position",
          "default": 50
        },
        {
          "type": "text",
          "id": "hotspot_label",
          "label": "Accessible hotspot label",
          "info": "Optional. Example: View black jacket details"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "EE product grid",
      "blocks": [
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        },
        {
          "type": "product"
        }
      ]
    }
  ]
}
{% endschema %}