{{ 'ee-product-grid.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign bonus_product = section.settings.bonus_product
  assign bonus_variant = blank

  if bonus_product != blank
    assign bonus_variant = bonus_product.selected_or_first_available_variant
  endif
-%}

<section
  id="GiftGuideGrid-{{ section.id }}"
  class="gift-guide-grid"
  data-gift-guide-grid
  data-section-id="{{ section.id }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
  data-product-root="{{ routes.root }}"
  {% if bonus_product != blank and bonus_variant != blank %}
    data-bonus-product-id="{{ bonus_product.id }}"
    data-bonus-product-title="{{ bonus_product.title | escape }}"
    data-bonus-variant-id="{{ bonus_variant.id }}"
    data-bonus-variant-available="{{ bonus_variant.available }}"
  {% endif %}
  style="
    --gg-grid-bg: {{ section.settings.background_color }};
    --gg-grid-heading-color: {{ section.settings.heading_color }};
    --gg-grid-max-width: {{ section.settings.max_width }}px;
    --gg-grid-gap: {{ section.settings.desktop_gap }}px;
    --gg-grid-mobile-gap: {{ section.settings.mobile_gap }}px;
    --gg-grid-padding-top: {{ section.settings.padding_top }}px;
    --gg-grid-padding-bottom: {{ section.settings.padding_bottom }}px;

    --gg-modal-width: {{ section.settings.modal_width }}px;
    --gg-modal-overlay-color: {{ section.settings.modal_overlay_color }};
    --gg-modal-overlay-opacity: {{ section.settings.modal_overlay_opacity | times: 0.01 }};
    --gg-modal-bg: {{ section.settings.modal_background_color }};
    --gg-modal-text: {{ section.settings.modal_text_color }};
    --gg-modal-muted: {{ section.settings.modal_muted_color }};
    --gg-modal-border: {{ section.settings.modal_border_color }};
    --gg-modal-button-bg: {{ section.settings.modal_button_background }};
    --gg-modal-button-text: {{ section.settings.modal_button_text }};
    --gg-modal-button-disabled-bg: {{ section.settings.modal_button_disabled_background }};
    --gg-modal-focus: {{ section.settings.modal_focus_color }};
  "
>
  <div class="gift-guide-grid__inner">
    {% if section.settings.heading != blank %}
      <h2 class="gift-guide-grid__heading">
        {{ section.settings.heading | escape }}
      </h2>
    {% endif %}

    <div class="gift-guide-grid__items">
      {% for block in section.blocks %}
        {% liquid
          assign selected_product = block.settings.product
          assign product_image = selected_product.featured_image
          assign product_image_alt = product_image.alt | default: selected_product.title
        %}

        <article
          class="gift-guide-grid__card"
          style="
            --gg-hotspot-x: {{ block.settings.hotspot_x }}%;
            --gg-hotspot-y: {{ block.settings.hotspot_y }}%;
            --gg-hotspot-mobile-x: {{ block.settings.hotspot_mobile_x }}%;
            --gg-hotspot-mobile-y: {{ block.settings.hotspot_mobile_y }}%;
          "
          {{ block.shopify_attributes }}
        >
          {% if selected_product != blank and product_image != blank %}
            <img
              class="gift-guide-grid__image"
              src="{{ product_image | image_url: width: 900 }}"
              srcset="
                {{ product_image | image_url: width: 320 }} 320w,
                {{ product_image | image_url: width: 480 }} 480w,
                {{ product_image | image_url: width: 640 }} 640w,
                {{ product_image | image_url: width: 900 }} 900w
              "
              sizes="
                (max-width: 749px) calc((100vw - 36px) / 2),
                calc((100vw - 160px) / 3)
              "
              width="{{ product_image.width }}"
              height="{{ product_image.height }}"
              alt="{{ product_image_alt | escape }}"
              loading="lazy"
            >

            <button
              type="button"
              class="gift-guide-grid__hotspot"
              aria-label="View details for {{ selected_product.title | escape }}"
              aria-haspopup="dialog"
              aria-controls="GiftGuideModal-{{ section.id }}"
              data-product-handle="{{ selected_product.handle }}"
              data-product-id="{{ selected_product.id }}"
            >
              <span class="visually-hidden">
                View {{ selected_product.title | escape }}
              </span>
            </button>
          {% else %}
            <div class="gift-guide-grid__placeholder">
              {{ 'product-1' | placeholder_svg_tag: 'gift-guide-grid__placeholder-svg' }}
            </div>

            <p class="gift-guide-grid__empty-message">
              Select a product
            </p>
          {% endif %}
        </article>
      {% endfor %}
    </div>
  </div>

  <div
    id="GiftGuideModal-{{ section.id }}"
    class="gift-guide-modal"
    data-gift-guide-modal
    aria-hidden="true"
    hidden
  >
    <button
      type="button"
      class="gift-guide-modal__overlay"
      aria-label="Close product details"
      tabindex="-1"
      data-modal-close
    ></button>

    <div
      class="gift-guide-modal__dialog"
      role="dialog"
      aria-modal="true"
      aria-labelledby="GiftGuideModalTitle-{{ section.id }}"
      aria-busy="false"
      tabindex="-1"
      data-modal-dialog
    >
      <button
        type="button"
        class="gift-guide-modal__close"
        aria-label="Close product details"
        data-modal-close
      >
        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="22"
          height="22"
          fill="none"
          focusable="false"
        >
          <path
            d="M6 6L18 18M18 6L6 18"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
          />
        </svg>
      </button>

      <div
        class="gift-guide-modal__loading"
        data-modal-loading
      >
        <span
          class="gift-guide-modal__spinner"
          aria-hidden="true"
        ></span>

        <p>
          {{ section.settings.modal_loading_text | escape }}
        </p>
      </div>

      <div
        class="gift-guide-modal__error"
        role="alert"
        data-modal-error
        hidden
      >
        {{ section.settings.modal_error_text | escape }}
      </div>

      <div
        class="gift-guide-modal__content"
        data-modal-content
        hidden
      >
        <div class="gift-guide-modal__product">
          <div class="gift-guide-modal__media">
            <img
              class="gift-guide-modal__image"
              src=""
              alt=""
              width="320"
              height="400"
              data-modal-image
            >
          </div>

          <div class="gift-guide-modal__info">
            <h3
              id="GiftGuideModalTitle-{{ section.id }}"
              class="gift-guide-modal__title"
              data-modal-title
            ></h3>

            <p
              class="gift-guide-modal__price"
              data-modal-price
            ></p>

            <div
              class="gift-guide-modal__description"
              data-modal-description
            ></div>
          </div>
        </div>

        <div
          class="gift-guide-modal__options"
          data-modal-options
        ></div>

        <p
          class="gift-guide-modal__status"
          role="status"
          aria-live="polite"
          aria-atomic="true"
          data-modal-status
        ></p>

        <button
          type="button"
          class="gift-guide-modal__add-button"
          data-modal-add
          disabled
        >
          <span data-modal-add-label>
            {{ section.settings.modal_button_label | escape }}
          </span>

          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            focusable="false"
          >
            <path
              d="M5 12H19M14 7L19 12L14 17"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script src="{{ 'ee-product-grid.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Gift guide product grid",
  "enabled_on": {
    "templates": ["page"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tisso vison in the wild"
    },
    {
      "type": "header",
      "content": "Black + Medium automatic product"
    },
    {
      "type": "product",
      "id": "bonus_product",
      "label": "Automatic bonus product",
      "info": "Select Soft Winter Jacket. It is automatically added when a selected variant contains both Black and Medium."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum content width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "default": 1380
    },
    {
      "type": "range",
      "id": "desktop_gap",
      "label": "Desktop gap",
      "min": 0,
      "max": 60,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_gap",
      "label": "Mobile gap",
      "min": 0,
      "max": 30,
      "step": 1,
      "unit": "px",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top spacing",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom spacing",
      "min": 20,
      "max": 140,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "header",
      "content": "Grid colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Popup content"
    },
    {
      "type": "text",
      "id": "modal_loading_text",
      "label": "Loading text",
      "default": "Loading product..."
    },
    {
      "type": "text",
      "id": "modal_error_text",
      "label": "Error text",
      "default": "Product details could not be loaded."
    },
    {
      "type": "text",
      "id": "modal_button_label",
      "label": "Add to cart label",
      "default": "ADD TO CART"
    },
    {
      "type": "range",
      "id": "modal_width",
      "label": "Popup maximum width",
      "min": 400,
      "max": 700,
      "step": 10,
      "unit": "px",
      "default": 500
    },
    {
      "type": "header",
      "content": "Popup colors"
    },
    {
      "type": "color",
      "id": "modal_overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "modal_overlay_opacity",
      "label": "Overlay opacity",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 50
    },
    {
      "type": "color",
      "id": "modal_background_color",
      "label": "Popup background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "modal_text_color",
      "label": "Main text color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "modal_muted_color",
      "label": "Description and status color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "modal_border_color",
      "label": "Option border color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "modal_button_background",
      "label": "Button background",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "modal_button_text",
      "label": "Button text",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "modal_button_disabled_background",
      "label": "Disabled button background",
      "default": "#B5B5B5"
    },
    {
      "type": "color",
      "id": "modal_focus_color",
      "label": "Keyboard focus color",
      "default": "#000000"
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "header",
          "content": "Desktop hotspot position"
        },
        {
          "type": "range",
          "id": "hotspot_x",
          "label": "Horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_y",
          "label": "Vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "header",
          "content": "Mobile hotspot position"
        },
        {
          "type": "range",
          "id": "hotspot_mobile_x",
          "label": "Horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "hotspot_mobile_y",
          "label": "Vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Gift guide product grid",
      "blocks": [
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" },
        { "type": "product" }
      ]
    }
  ]
}
{% endschema %}