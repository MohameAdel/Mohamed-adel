

{{ 'ee-gift-banner.css' | asset_url | stylesheet_tag }}

{% liquid
    
  assign desktop_image = section.settings.desktop_image
  assign mobile_image = section.settings.mobile_image

  if mobile_image == blank
    assign mobile_image = desktop_image
  endif

  assign image_alt = desktop_image.alt | default: section.settings.heading
  assign top_button_link = section.settings.top_button_link | default: routes.all_products_collection_url
  assign main_button_link = section.settings.main_button_link | default: routes.all_products_collection_url
%}

<section
  id="GiftGuideBanner-{{ section.id }}"
  class="gift-guide-banner"
  style="
    --gg-section-bg: {{ section.settings.section_bg_color }};

    --gg-topbar-bg: {{ section.settings.topbar_bg_color }};
    --gg-logo-color: {{ section.settings.logo_color }};
    --gg-message-color: {{ section.settings.message_color }};
    --gg-menu-color: {{ section.settings.menu_color }};

    --gg-hero-bg: {{ section.settings.hero_bg_color }};
    --gg-heading-color: {{ section.settings.heading_color }};
    --gg-description-color: {{ section.settings.description_color }};

    --gg-top-button-bg: {{ section.settings.top_button_bg_color }};
    --gg-top-button-text: {{ section.settings.top_button_text_color }};
    --gg-top-button-border: {{ section.settings.top_button_border_color }};
    --gg-top-button-hover-bg: {{ section.settings.top_button_hover_bg_color }};
    --gg-top-button-hover-text: {{ section.settings.top_button_hover_text_color }};
    --gg-top-button-hover-border: {{ section.settings.top_button_hover_border_color }};

    --gg-main-button-bg: {{ section.settings.main_button_bg_color }};
    --gg-main-button-text: {{ section.settings.main_button_text_color }};
    --gg-main-button-border: {{ section.settings.main_button_border_color }};
    --gg-main-button-hover-bg: {{ section.settings.main_button_hover_bg_color }};
    --gg-main-button-hover-text: {{ section.settings.main_button_hover_text_color }};
    --gg-main-button-hover-border: {{ section.settings.main_button_hover_border_color }};

    --gg-bottom-bg: {{ section.settings.bottom_bg_color }};
    --gg-bottom-text: {{ section.settings.bottom_text_color }};

    --gg-focus-color: {{ section.settings.focus_color }};
  "
>
  <header class="gift-guide-banner__topbar">
    <span
      class="gift-guide-banner__menu-icon"
      aria-hidden="true"
    >
      <span></span>
      <span></span>
      <span></span>
    </span>

    {% if section.settings.logo_text != blank %}
      <p class="gift-guide-banner__logo">
        {{ section.settings.logo_text | escape }}
      </p>
    {% endif %}

    {% if section.settings.top_message != blank %}
      <p class="gift-guide-banner__message">
        {{ section.settings.top_message | escape }}
      </p>
    {% endif %}

    {% if section.settings.top_button_label != blank %}
      <a
        class="gift-guide-button gift-guide-button--accent gift-guide-banner__top-button"
        href="{{ top_button_link }}"
      >
        <span>{{ section.settings.top_button_label | escape }}</span>

        <svg
          aria-hidden="true"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
        >
          <path
            d="M5 12H19M14 7L19 12L14 17"
            stroke="currentColor"
            stroke-width="1.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
        </svg>
      </a>
    {% endif %}
  </header>

  <div class="gift-guide-banner__hero">
    <div class="gift-guide-banner__media">
      {% if desktop_image != blank %}
        <picture>
          {% if mobile_image != blank %}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ mobile_image | image_url: width: 375 }} 375w,
                {{ mobile_image | image_url: width: 550 }} 550w,
                {{ mobile_image | image_url: width: 750 }} 750w
              "
              sizes="100vw"
            >
          {% endif %}

          <img
            class="gift-guide-banner__image"
            src="{{ desktop_image | image_url: width: 1600 }}"
            srcset="
              {{ desktop_image | image_url: width: 750 }} 750w,
              {{ desktop_image | image_url: width: 1100 }} 1100w,
              {{ desktop_image | image_url: width: 1600 }} 1600w,
              {{ desktop_image | image_url: width: 2200 }} 2200w
            "
            sizes="100vw"
            width="{{ desktop_image.width }}"
            height="{{ desktop_image.height }}"
            alt="{{ image_alt | escape }}"
            loading="eager"
            fetchpriority="high"
          >
        </picture>
      {% else %}
        <div class="gift-guide-banner__placeholder">
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <div class="gift-guide-banner__content">
      {% if section.settings.heading != blank %}
        <h1 class="gift-guide-banner__heading">
          {{ section.settings.heading | escape }}
        </h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="gift-guide-banner__description rte">
          {{ section.settings.description }}
        </div>
      {% endif %}

      {% if section.settings.main_button_label != blank %}
        <a
          class="gift-guide-button gift-guide-button--dark"
          href="{{ main_button_link }}"
        >
          <span>{{ section.settings.main_button_label | escape }}</span>

          <svg
            aria-hidden="true"
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
          >
            <path
              d="M5 12H19M14 7L19 12L14 17"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </a>
      {% endif %}
    </div>
  </div>

  {% if section.settings.bottom_message != blank %}
    <p class="gift-guide-banner__bottom-message">
      {{ section.settings.bottom_message | escape }}
    </p>
  {% endif %}
</section>

